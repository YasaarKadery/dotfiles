[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
	syntax-theme = gruvbox-dark
	line-numbers = true

[merge]
	conflictStyle = zdiff3

# Put machine-specific user.name / user.email in ~/.gitconfig.local
[include]
	path = ~/.gitconfig.local
[user]
	name = Yasaar Kadery
	email = ykadery12@gmail.com
