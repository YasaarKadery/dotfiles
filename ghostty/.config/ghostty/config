font-family = JetBrainsMono Nerd Font
font-size = 16
font-thicken = true
adjust-cell-height = 15%
window-colorspace = display-p3

# Restore windows/tabs on relaunch (macOS)
window-save-state = always

# Frosted glass (falls back to standard blur on Linux; try `20` or `macos-glass-clear` on macOS)
background-opacity = 0.88
background-blur = macos-glass-regular

# Gruvbox Dark Hard
background = #1d2021
foreground = #ebdbb2
selection-background = #ebdbb2
selection-foreground = #1d2021
cursor-color = #ebdbb2
cursor-text = #1d2021
palette = 0=#1d2021
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2
